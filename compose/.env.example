# Copy this file to .env and replace every change-me value before starting JARVIS.
DB_USER=jarvis
POSTGRES_PASSWORD=change-me
REDIS_PASSWORD=change-me
MQTT_PASSWORD=change-me
AUTH_SECRET_KEY=change-me
ADMIN_API_KEY=change-me
MODEL_SERVICE_TOKEN=change-me
JARVIS_AUTH_ADMIN_TOKEN=change-me
JARVIS_CONFIG_ADMIN_TOKEN=change-me
JARVIS_ADAPTER_CALLBACK_TOKEN=change-me
GRAFANA_ADMIN_PASSWORD=change-me

# Local model configuration. Model weights are downloaded separately and are not stored in Git.
MODELS_DIR=./.models
JARVIS_MODEL_BACKEND=GGUF
JARVIS_LIVE_MODEL_BACKEND=GGUF
JARVIS_MODEL_CHAT_FORMAT=chatml
JARVIS_LIVE_MODEL_CHAT_FORMAT=chatml
JARVIS_MODEL_CONTEXT_WINDOW=32768
JARVIS_LIVE_MODEL_CONTEXT_WINDOW=32768
JARVIS_N_GPU_LAYERS=all
JARVIS_FLASH_ATTN=true
WHISPER_MODELS_DIR=./whisper-models
WHISPER_MODEL=/whisper-models/ggml-base.en.bin

# Local service ports
POSTGRES_PORT=5432
REDIS_PORT=6379
MOSQUITTO_PORT=1883
AUTH_PORT=7701
COMMAND_CENTER_PORT=7702
CONFIG_SERVICE_PORT=7703
LLM_PROXY_API_PORT=7705
WHISPER_API_PORT=7706
TTS_PORT=7707
NOTIFICATIONS_PORT=7708
SETTINGS_SERVER_PORT=7709
LOGS_PORT=7710
ADMIN_PORT=7711
GRAFANA_PORT=3000
LOKI_PORT=3100

